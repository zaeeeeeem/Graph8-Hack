# Copy to frontend/.env.local (gitignored). Never commit real values.
# Public Supabase settings: the ANON key only. Never put the service-role key in the frontend.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Workspace shown to signed-in users who are not a member of any workspace yet (the public demo one).
NEXT_PUBLIC_WORKSPACE_ID=a0000000-0000-4000-8000-000000000001
NEXT_PUBLIC_G8_APP_URL=https://app.graph8.com
