{
  "display_information": {
    "name": "Graphi",
    "description": "Your AI sales team: Head of Sales, Scout, Researcher, SDR, Closer.",
    "background_color": "#1f2a44"
  },
  "features": {
    "bot_user": { "display_name": "Graphi", "always_online": true },
    "app_home": { "messages_tab_enabled": true, "messages_tab_read_only_enabled": false },
    "slash_commands": [
      { "command": "/hire-sales", "description": "Hire your AI sales team for a company URL", "usage_hint": "8x.social", "should_escape": false },
      { "command": "/sales-standup", "description": "Get today's standup from the Head of Sales", "should_escape": false }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read", "channels:history", "channels:join", "channels:manage", "channels:read",
        "chat:write", "chat:write.customize", "chat:write.public", "commands",
        "groups:history", "groups:read", "im:history", "im:read", "im:write",
        "reactions:write", "users:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": { "bot_events": ["app_mention", "message.channels", "message.groups", "message.im"] },
    "interactivity": { "is_enabled": true },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
