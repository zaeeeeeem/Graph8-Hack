{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,
    "types": [
      "node"
    ],
    "rootDir": ".."
  },
  "include": [
    "src/**/*.ts",
    "../shared/**/*.ts",
    "../scripts/**/*.ts"
  ],
  "exclude": [
    "../scripts/verify/**"
  ]
}